datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  BRANCH_MANAGER
  CASHIER
}

enum ItemSourceType {
  COMMISSARY_SUPPLIED
  BRANCH_SOURCED
  FINISHED_PRODUCT
}

enum TransactionType {
  SALE
  PRODUCTION
  STOCK_RECEIPT
  ADJUSTMENT
}

enum AlertStatus {
  PENDING
  RESOLVED
}

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  password          String
  role              Role               @default(CASHIER)
  branchId          String?            
  branch            Branch?            @relation(fields: [branchId], references: [id])
  stockTransactions StockTransaction[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Branch {
  id                String             @id @default(uuid())
  name              String
  location          String
  users             User[]
  branchStocks      BranchStock[]
  stockTransactions StockTransaction[]
  reorderAlerts     ReorderAlert[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Item {
  id                 String             @id @default(uuid())
  name               String
  sourceType         ItemSourceType
  unit               String
  minThreshold       Float              @default(10.0)
  branchStocks       BranchStock[]
  recipeAsFinished   ProductionRecipe[] @relation("FinishedProduct")
  recipeAsIngredient ProductionRecipe[] @relation("IngredientProduct")
  stockTransactions  StockTransaction[]
  reorderAlerts      ReorderAlert[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model BranchStock {
  id        String   @id @default(uuid())
  branchId  String
  itemId    String
  quantity  Float    @default(0.0)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([branchId, itemId])
}

model ProductionRecipe {
  id                String   @id @default(uuid())
  finishedItemId    String
  finishedItem      Item     @relation("FinishedProduct", fields: [finishedItemId], references: [id], onDelete: Cascade)
  ingredientItemId  String
  ingredientItem    Item     @relation("IngredientProduct", fields: [ingredientItemId], references: [id], onDelete: Cascade)
  requiredQuantity  Float    

  @@unique([finishedItemId, ingredientItemId])
}

model StockTransaction {
  id              String          @id @default(uuid())
  type            TransactionType
  branchId        String
  itemId          String
  quantityDelta   Float           
  userId          String
  branch          Branch          @relation(fields: [branchId], references: [id])
  item            Item            @relation(fields: [itemId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  createdAt       DateTime        @default(now())
}

model ReorderAlert {
  id        String      @id @default(uuid())
  branchId  String
  itemId    String
  status    AlertStatus @default(PENDING)
  branch    Branch      @relation(fields: [branchId], references: [id])
  item      Item        @relation(fields: [itemId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}